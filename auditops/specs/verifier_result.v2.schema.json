{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier_result.v2",
  "title": "AuditOps VerifierResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verifier_result_version", "task_id", "passed", "release_allowed",
    "disposition", "repair_count", "repair_allowed", "checks",
    "repair_errors"
  ],
  "properties": {
    "verifier_result_version": {"const": "v2"},
    "task_id": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "release_allowed": {"type": "boolean"},
    "disposition": {
      "enum": [
        "TOOL_CALL_APPROVED", "REPAIR_REQUIRED", "RELEASED",
        "SAFE_REFUSAL", "FAILED"
      ]
    },
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "repair_allowed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "repair_errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/repairError"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"passed": {"const": true}}},
      "then": {
        "properties": {
          "disposition": {
            "enum": ["TOOL_CALL_APPROVED", "RELEASED", "SAFE_REFUSAL"]
          },
          "checks": {
            "not": {"contains": {"properties": {"passed": {"const": false}}}}
          }
        }
      },
      "else": {
        "properties": {
          "disposition": {"enum": ["REPAIR_REQUIRED", "FAILED"]},
          "release_allowed": {"const": false},
          "checks": {
            "contains": {"properties": {"passed": {"const": false}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "REPAIR_REQUIRED"}}},
      "then": {
        "properties": {
          "passed": {"const": false},
          "release_allowed": {"const": false},
          "repair_count": {"const": 0},
          "repair_allowed": {"const": true},
          "repair_errors": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "repair_allowed": {"const": false},
          "repair_errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {"enum": ["RELEASED", "SAFE_REFUSAL"]}
        }
      },
      "then": {
        "properties": {
          "passed": {"const": true},
          "release_allowed": {"const": true}
        }
      },
      "else": {"properties": {"release_allowed": {"const": false}}}
    }
  ],
  "$defs": {
    "checkCode": {
      "enum": [
        "ANSWER_SHAPE_VALID", "ANSWER_TEXT_MATCH", "ARITHMETIC_VALID",
        "CITATIONS_MATCH", "EVIDENCE_VALID", "FILING_MATCH",
        "MODEL_GENERATION_FAILED", "MODEL_OUTPUT_NOT_STRICT_JSON",
        "OBSERVATION_EVIDENCE_VALID", "OBSERVATION_PERIOD_MATCH",
        "OBSERVATION_SCOPE_VALID", "OPERATION_MATCH", "PERIOD_MATCH",
        "PROMPT_INJECTION_CLEAR", "QUERY_MATCH", "REFUSAL_VALID",
        "RETRIEVAL_LIMITS_MATCH", "SCHEMA_VALID", "STATUS_MATCH",
        "SUPPORT_VALID", "TASK_MATCH", "TOOL_ALLOWED",
        "TOOL_ARGUMENTS_VALID", "TOOL_OBSERVATION_PRESENT",
        "UNEXPECTED_STAGE_ACTION", "UNIT_MATCH", "VALUE_MATCH"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "field", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/checkCode"},
        "passed": {"type": "boolean"},
        "field": {"type": ["string", "null"], "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "repairError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "field", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/checkCode"},
        "field": {"type": ["string", "null"], "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
