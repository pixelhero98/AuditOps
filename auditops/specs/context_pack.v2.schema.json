{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context_pack.v2",
  "title": "AuditOps ContextPackV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_pack_version", "instructions", "task", "few_shot_examples",
    "evidence_items", "security_flags", "selection_provenance", "token_count",
    "max_input_tokens", "context_sha256"
  ],
  "properties": {
    "context_pack_version": {"const": "v2"},
    "instructions": {"type": "string", "minLength": 1},
    "task": {"$ref": "agent_task_input.v2.schema.json"},
    "few_shot_examples": {
      "type": "array",
      "oneOf": [
        {"maxItems": 0},
        {"minItems": 8, "maxItems": 8}
      ],
      "items": {"$ref": "#/$defs/fewShotExample"}
    },
    "evidence_items": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "security_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "selection_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_method", "empty_reason", "ordered_evidence_ids"],
      "properties": {
        "selection_method": {
          "enum": ["TYPED_FACT_MATERIALIZATION", "FROZEN_BM25"]
        },
        "empty_reason": {
          "enum": [null, "NO_VALID_FACTS", "NO_MATCHING_EVIDENCE"]
        },
        "ordered_evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"ordered_evidence_ids": {"maxItems": 0}}},
          "then": {
            "properties": {
              "empty_reason": {
                "enum": ["NO_VALID_FACTS", "NO_MATCHING_EVIDENCE"]
              }
            }
          },
          "else": {"properties": {"empty_reason": {"type": "null"}}}
        }
      ]
    },
    "token_count": {"type": "integer", "minimum": 0, "maximum": 14336},
    "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 14336},
    "context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fewShotExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example_id", "template_id", "task_family", "task",
        "evidence_items", "assistant_response"
      ],
      "properties": {
        "example_id": {"type": "string", "minLength": 1},
        "template_id": {"type": "string", "minLength": 1},
        "task_family": {
          "type": "string",
          "pattern": "^(?:quant_metric|narrative_citation)(?::[^:]+)*$"
        },
        "task": {"$ref": "agent_task_input.v2.schema.json"},
        "evidence_items": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/evidenceItem"}
        },
        "assistant_response": {"$ref": "agent_proposal.v2.schema.json"}
      }
    },
    "dimensionValue": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "member"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "member": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number"}, {"type": "number"},
            {"type": "number"}, {"type": "number"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "char_end": {"type": "integer", "minimum": 0},
        "char_start": {"type": "integer", "minimum": 0},
        "concept": {"type": ["string", "null"], "minLength": 1},
        "concept_norm": {"type": ["string", "null"], "minLength": 1},
        "context_id": {"type": ["string", "null"], "minLength": 1},
        "derived": {"type": "boolean"},
        "dimensions": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/dimensionValue"}
        },
        "entity_id": {"type": ["string", "null"], "minLength": 1},
        "heading": {"type": ["string", "null"], "minLength": 1},
        "heading_path": {"type": ["string", "null"], "minLength": 1},
        "input_name": {"type": ["string", "null"], "minLength": 1},
        "item": {"type": ["string", "null"], "minLength": 1},
        "page": {"type": "integer", "minimum": 0},
        "scenario": {"type": ["string", "null"], "minLength": 1},
        "source_anchor": {"type": ["string", "null"], "minLength": 1},
        "source_file": {"type": ["string", "null"], "minLength": 1},
        "subheading": {"type": ["string", "null"], "minLength": 1},
        "taxonomy": {"type": ["string", "null"], "minLength": 1},
        "transformation": {"type": ["string", "null"], "minLength": 1},
        "unit_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "filing_id", "content"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "filing_id": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 1},
        "period_key": {"type": ["string", "null"], "minLength": 1},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "value": {"type": ["string", "number", "null"]},
        "source_system": {"type": ["string", "null"], "minLength": 1},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    }
  }
}
