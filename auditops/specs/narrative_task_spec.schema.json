        "null"
      ]
    },
    "item": {
      "type": [
        "string",
        "null"
      ]
    },
    "heading": {
      "type": [
        "string",
        "null"
      ]
    },
    "subheading": {
      "type": [
        "string",
        "null"
      ]
    },
    "heading_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "type": "string"
    },
    "retrieval_query": {
      "type": "string"
    },
