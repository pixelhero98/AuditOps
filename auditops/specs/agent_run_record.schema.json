{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_run_record.v1",
  "title": "AuditOps AgentRunRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_run_record_version",
    "run_id",
    "task_id",
    "corpus_id",
    "benchmark_manifest_sha256",
    "runtime_mode",
    "prompt_condition",
    "prompt_version",
    "prompt_sha256",
    "model_config",
    "context_sha256",
    "input_sha256",
    "output_sha256",
    "tool_calls",
    "verifier_trace",
    "verifier_result",
    "repair_count",
    "final_disposition",
    "token_usage",
    "timings",
    "resources",
    "provenance"
  ],
  "properties": {
    "agent_run_record_version": {"const": "v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "benchmark_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_mode": {"enum": ["direct", "agent"]},
    "prompt_condition": {"enum": ["zero_shot", "few_shot"]},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "model_config": {"$ref": "model_config.schema.json"},
    "context_sha256": {"$ref": "#/$defs/nullableSha256"},
    "input_sha256": {"$ref": "#/$defs/nullableSha256"},
    "output_sha256": {"$ref": "#/$defs/nullableSha256"},
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "arguments_sha256", "observation_sha256", "status", "duration_ms"],
        "properties": {
          "tool_name": {"enum": ["evaluate_metric_spec", "retrieve_evidence"]},
          "arguments_sha256": {"$ref": "#/$defs/sha256"},
          "observation_sha256": {"$ref": "#/$defs/nullableSha256"},
          "status": {"enum": ["OK", "ERROR"]},
          "duration_ms": {"type": "number", "minimum": 0}
        }
      }
    },
    "verifier_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "attempt_index",
          "repair_attempt",
          "prompt_sha256",
          "output_sha256",
          "proposal",
          "proposal_sha256",
          "verifier_result",
          "input_tokens",
          "output_tokens",
          "duration_ms"
        ],
        "properties": {
          "stage": {"enum": ["plan", "synthesis", "direct"]},
          "attempt_index": {"type": "integer", "minimum": 0},
          "repair_attempt": {"type": "boolean"},
          "prompt_sha256": {"$ref": "#/$defs/sha256"},
          "output_sha256": {"$ref": "#/$defs/nullableSha256"},
          "proposal": {
            "anyOf": [
              {"$ref": "agent_proposal.schema.json"},
              {"type": "null"}
            ]
          },
          "proposal_sha256": {"$ref": "#/$defs/nullableSha256"},
          "verifier_result": {"$ref": "verifier_result.schema.json"},
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "duration_ms": {"type": "number", "minimum": 0}
        }
      }
    },
    "verifier_result": {
      "anyOf": [
        {"$ref": "verifier_result.schema.json"},
        {"type": "null"}
      ]
    },
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "final_disposition": {
      "enum": [
        "TOOL_CALL_APPROVED",
        "RELEASED",
        "SAFE_REFUSAL",
        "REPAIR_REQUIRED",
        "FAILED",
        "INFRASTRUCTURE_FAILURE"
      ]
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "duration_ms"],
      "properties": {
        "started_at": {"type": "string", "minLength": 1},
        "finished_at": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "number", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slurm_job_id", "gpu_model", "peak_vram_bytes", "host"],
      "properties": {
        "slurm_job_id": {"type": ["string", "null"], "minLength": 1},
        "gpu_model": {"type": ["string", "null"], "minLength": 1},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "host": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "source_tree_sha256",
        "container_digest",
        "model_snapshot_sha256",
        "tokenizer_revision",
        "package_lock_sha256"
      ],
      "properties": {
        "git_commit": {"type": ["string", "null"], "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/nullableSha256"},
        "container_digest": {"type": ["string", "null"], "minLength": 1},
        "model_snapshot_sha256": {"$ref": "#/$defs/nullableSha256"},
        "tokenizer_revision": {"type": ["string", "null"], "minLength": 1},
        "package_lock_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
