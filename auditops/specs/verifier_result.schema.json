{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier_result.v1",
  "title": "AuditOps VerifierResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verifier_result_version",
    "task_id",
    "passed",
    "release_allowed",
    "disposition",
    "repair_count",
    "repair_allowed",
    "checks",
    "repair_errors"
  ],
  "properties": {
    "verifier_result_version": {"const": "v1"},
    "task_id": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "release_allowed": {"type": "boolean"},
    "disposition": {
      "enum": ["TOOL_CALL_APPROVED", "RELEASED", "SAFE_REFUSAL", "REPAIR_REQUIRED", "FAILED"]
    },
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "repair_allowed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "repair_errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/repairError"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "field", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "field": {"type": ["string", "null"], "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "repairError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "field", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "field": {"type": ["string", "null"], "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
