{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_arguments.v2",
  "title": "AuditOps ToolArgumentsV2",
  "oneOf": [
    {"$ref": "#/$defs/metric"},
    {"$ref": "#/$defs/retrieval"}
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filing_id", "metric_spec_id", "period_key"],
      "properties": {
        "filing_id": {"type": "string", "minLength": 1},
        "metric_spec_id": {"type": "string", "minLength": 1},
        "period_key": {"type": "string", "minLength": 1}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filing_id", "query", "top_k", "candidate_k"],
      "properties": {
        "filing_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "top_k": {"const": 5},
        "candidate_k": {"const": 15}
      }
    }
  }
}
