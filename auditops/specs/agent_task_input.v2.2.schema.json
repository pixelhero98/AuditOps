{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_task_input.v2.2",
  "title": "AuditOps AgentTaskInputV2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_task_input_version",
    "task_id",
    "task_type",
    "jurisdiction",
    "reporting_framework",
    "standards_profile",
    "source_system",
    "question",
    "entity",
    "filing",
    "period",
    "task_parameters",
    "allowed_tools",
    "evidence_scope",
    "output_schema_id",
    "refusal_policy",
    "narrative_subtype",
    "metric_operation_contract"
  ],
  "properties": {
    "agent_task_input_version": {
      "const": "v2.2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "quant_metric",
        "narrative_citation"
      ]
    },
    "jurisdiction": {
      "enum": [
        "US",
        "UK"
      ]
    },
    "reporting_framework": {
      "type": "string",
      "minLength": 1
    },
    "standards_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "name"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "source_entity_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "filing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filing_id"
      ],
      "properties": {
        "filing_id": {
          "type": "string",
          "minLength": 1
        },
        "form_type": {
          "type": "string",
          "minLength": 1
        },
        "accession": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_key"
      ],
      "properties": {
        "period_key": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "minLength": 1
        },
        "end_date": {
          "type": "string",
          "minLength": 1
        },
        "instant": {
          "type": "string",
          "minLength": 1
        },
        "selector_periods": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current_period_end_asof": {
              "type": "string",
              "pattern": "^ASOF_[0-9]{8}$"
            },
            "prior_year_period_end_asof": {
              "type": "string",
              "pattern": "^ASOF_[0-9]{8}$"
            }
          },
          "minProperties": 1
        }
      }
    },
    "task_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_spec_id",
        "retrieval_query"
      ],
      "properties": {
        "metric_spec_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_query": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "evaluate_metric_spec",
          "load_frozen_evidence"
        ]
      }
    },
    "evidence_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ids",
        "filing_ids",
        "max_items",
        "selection_method",
        "empty_reason"
      ],
      "properties": {
        "evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filing_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "selection_method": {
          "enum": [
            "TYPED_FACT_MATERIALIZATION",
            "FROZEN_BM25"
          ]
        },
        "empty_reason": {
          "enum": [
            null,
            "NO_VALID_FACTS",
            "NO_MATCHING_EVIDENCE"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "empty_reason": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "empty_reason": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "output_schema_id": {
      "enum": [
        "quantitative_answer_or_refusal.v2.2",
        "narrative_selection_or_refusal.v2.2"
      ]
    },
    "refusal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_codes"
      ],
      "properties": {
        "allowed_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "narrative_subtype": {
      "enum": [
        null,
        "footnote_note",
        "accounting_policy",
        "auditor_report_opinion_language",
        "critical_audit_matter"
      ]
    },
    "metric_operation_contract": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_operation_contract_version",
            "metric_spec_id",
            "metric_spec_version",
            "kind",
            "ordered_inputs",
            "formula",
            "output_unit",
            "applicable_period_types",
            "deterministic_refusal_conditions",
            "contract_sha256"
          ],
          "properties": {
            "metric_operation_contract_version": {
              "const": "v2.2"
            },
            "metric_spec_id": {
              "type": "string",
              "minLength": 1
            },
            "metric_spec_version": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "ordered_inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "unit_family",
                  "period"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit_family": {
                    "type": "string",
                    "minLength": 1
                  },
                  "period": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "formula": {
              "type": "object",
              "minProperties": 1
            },
            "output_unit": {
              "type": "string",
              "minLength": 1
            },
            "applicable_period_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deterministic_refusal_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "contract_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "quant_metric"
          }
        }
      },
      "then": {
        "properties": {
          "task_parameters": {
            "properties": {
              "metric_spec_id": {
                "type": "string",
                "minLength": 1
              },
              "retrieval_query": {
                "type": "null"
              }
            }
          },
          "allowed_tools": {
            "prefixItems": [
              {
                "const": "evaluate_metric_spec"
              }
            ]
          },
          "evidence_scope": {
            "properties": {
              "selection_method": {
                "const": "TYPED_FACT_MATERIALIZATION"
              },
              "empty_reason": {
                "enum": [
                  null,
                  "NO_VALID_FACTS"
                ]
              }
            }
          },
          "output_schema_id": {
            "const": "quantitative_answer_or_refusal.v2.2"
          },
          "refusal_policy": {
            "properties": {
              "allowed_codes": {
                "items": {
                  "enum": [
                    "AMBIGUOUS_CONTEXT",
                    "DIVISION_BY_ZERO",
                    "INCOMPATIBLE_UNITS",
                    "MISSING_INPUT",
                    "PERIOD_NOT_SUPPORTED",
                    "PROMPT_INJECTION_DETECTED",
                    "UNSUPPORTED_REQUEST",
                    "ZERO_DENOMINATOR"
                  ]
                }
              }
            }
          },
          "narrative_subtype": {
            "type": "null"
          },
          "metric_operation_contract": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "task_parameters": {
            "properties": {
              "metric_spec_id": {
                "type": "null"
              },
              "retrieval_query": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allowed_tools": {
            "prefixItems": [
              {
                "const": "load_frozen_evidence"
              }
            ]
          },
          "evidence_scope": {
            "properties": {
              "selection_method": {
                "const": "FROZEN_BM25"
              },
              "empty_reason": {
                "enum": [
                  null,
                  "NO_MATCHING_EVIDENCE"
                ]
              }
            }
          },
          "output_schema_id": {
            "const": "narrative_selection_or_refusal.v2.2"
          },
          "refusal_policy": {
            "properties": {
              "allowed_codes": {
                "items": {
                  "enum": [
                    "NARRATIVE_CITATION_MISS",
                    "NARRATIVE_NOT_SUPPORTED",
                    "PROMPT_INJECTION_DETECTED",
                    "TASK_NOT_SUPPORTED",
                    "UNSUPPORTED_REQUEST"
                  ]
                }
              }
            }
          },
          "narrative_subtype": {
            "enum": [
              "footnote_note",
              "accounting_policy",
              "auditor_report_opinion_language",
              "critical_audit_matter"
            ]
          },
          "metric_operation_contract": {
            "type": "null"
          }
        }
      }
    }
  ]
}
