{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_run_record.v2.3",
  "title": "AuditOps AgentRunRecordV2.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_run_record_version",
    "run_id",
    "task_id",
    "corpus_id",
    "benchmark_manifest_sha256",
    "runtime_mode",
    "runtime_version",
    "prompt_condition",
    "prompt_version",
    "prompt_sha256",
    "canonical_json_version",
    "semantic_model_config_sha256",
    "deployment_model_config_sha256",
    "deterministic_executor_sha256",
    "stage_schema_bundle_sha256",
    "run_envelope_sha256",
    "demonstration_pack_sha256",
    "narrative_subtype",
    "metric_operation_contract_sha256",
    "model_config",
    "context_sha256",
    "input_sha256",
    "output_sha256",
    "tool_calls",
    "verifier_trace",
    "verifier_result",
    "repair_count",
    "outcome",
    "token_usage",
    "timings",
    "resources",
    "provenance",
    "narrative_selection_policy_sha256"
  ],
  "properties": {
    "agent_run_record_version": {
      "const": "v2.3"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{24}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_mode": {
      "enum": [
        "direct",
        "capability_agent",
        "safety_hybrid"
      ]
    },
    "runtime_version": {
      "const": "auditops.agent_runtime.v2.3"
    },
    "prompt_condition": {
      "enum": [
        "zero_shot",
        "few_shot"
      ]
    },
    "prompt_version": {
      "const": "auditops.agent_prompt.v2.3"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_json_version": {
      "const": "auditops.canonical_json.v1"
    },
    "semantic_model_config_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "deployment_model_config_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "deterministic_executor_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stage_schema_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_config": {
      "oneOf": [
        {
          "$ref": "model_config.v2.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "output_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "tool_calls": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/toolCall"
      }
    },
    "verifier_trace": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/traceEntry"
      }
    },
    "verifier_result": {
      "oneOf": [
        {
          "$ref": "verifier_result.v2.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "outcome": {
      "enum": [
        "RELEASED",
        "SAFE_REFUSAL",
        "MODEL_FAILURE",
        "INFRASTRUCTURE_FAILURE",
        "INTEGRITY_FAILURE"
      ]
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms",
        "engine_initialization_ms",
        "generation_duration_ms",
        "tool_duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "finished_at": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "engine_initialization_ms": {
          "type": "number",
          "minimum": 0
        },
        "generation_duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "tool_duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slurm_job_id",
        "gpu_model",
        "peak_vram_bytes",
        "host"
      ],
      "properties": {
        "slurm_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "peak_vram_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "source_tree_sha256",
        "container_digest",
        "model_snapshot_sha256",
        "tokenizer_revision",
        "package_lock_sha256"
      ],
      "properties": {
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "container_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_snapshot_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "tokenizer_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_lock_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "demonstration_pack_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "narrative_subtype": {
      "enum": [
        null,
        "footnote_note",
        "accounting_policy",
        "auditor_report_opinion_language",
        "critical_audit_matter"
      ]
    },
    "metric_operation_contract_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "narrative_selection_policy_sha256": {
      "$ref": "#/$defs/nullableSha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_config": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "runtime_mode": {
            "const": "safety_hybrid"
          },
          "semantic_model_config_sha256": {
            "type": "null"
          },
          "deployment_model_config_sha256": {
            "type": "null"
          },
          "verifier_trace": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verifier_trace": {
            "contains": {
              "properties": {
                "verifier_result": {
                  "properties": {
                    "disposition": {
                      "const": "REPAIR_REQUIRED"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verifier_trace": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "narrative_subtype": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "narrative_selection_policy_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "else": {
        "properties": {
          "narrative_selection_policy_sha256": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments_sha256",
        "observation_sha256",
        "status",
        "duration_ms"
      ],
      "properties": {
        "tool_name": {
          "enum": [
            "evaluate_metric_spec",
            "load_frozen_evidence"
          ]
        },
        "arguments_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observation_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "status": {
          "enum": [
            "OK",
            "ERROR"
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "traceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "attempt_index",
        "repair_attempt",
        "prompt_sha256",
        "request_sha256",
        "response_schema_sha256",
        "visible_context_sha256",
        "output_sha256",
        "proposal",
        "proposal_sha256",
        "verifier_result",
        "input_tokens",
        "output_tokens",
        "duration_ms",
        "finish_reason",
        "constraint_backend",
        "structured_output_applied",
        "output_bytes",
        "cap_hit",
        "parse_category"
      ],
      "properties": {
        "stage": {
          "enum": [
            "direct",
            "plan",
            "synthesis"
          ]
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 0
        },
        "repair_attempt": {
          "type": "boolean"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "response_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "visible_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "proposal": {
          "oneOf": [
            {
              "$ref": "agent_proposal.v2.3.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposal_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "verifier_result": {
          "$ref": "verifier_result.v2.schema.json"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "finish_reason": {
          "enum": [
            null,
            "stop",
            "length",
            "abort"
          ]
        },
        "constraint_backend": {
          "type": "string",
          "minLength": 1
        },
        "structured_output_applied": {
          "type": "boolean"
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cap_hit": {
          "type": "boolean"
        },
        "parse_category": {
          "enum": [
            null,
            "EMPTY",
            "NON_OBJECT",
            "SYNTAX",
            "DUPLICATE_KEY",
            "NON_JSON_NUMBER"
          ]
        }
      }
    }
  }
}
