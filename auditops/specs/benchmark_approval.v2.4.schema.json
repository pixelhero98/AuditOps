{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditops.local/specs/benchmark_approval.v2.4.schema.json",
  "title": "BenchmarkApprovalV2.4",
  "type": "object",
  "required": [
    "approval_version", "candidate_id", "candidate_manifest_sha256",
    "rendered_packet_sha256", "review_packet_json_sha256", "source_manifest_sha256",
    "source_hashes", "primary_review", "secondary_review", "adjudication",
    "approved_task_ids_sha256", "approved_case_count", "external_human_approval", "approval_id"
  ],
  "properties": {
    "approval_version": {"const": "auditops-benchmark-approval.v2.4"},
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rendered_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_packet_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_hashes": {"type": "object"},
    "primary_review": {"type": "object"},
    "secondary_review": {"type": "object"},
    "adjudication": {"type": ["object", "null"]},
    "approved_task_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_case_count": {"const": 200},
    "external_human_approval": {"const": true},
    "approval_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
