{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditops.local/specs/narrative_gold.v2.4.schema.json",
  "title": "NarrativeGoldV2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gold_record_version", "schema_id", "task_id", "task_type", "template_id",
    "task_family", "strata", "jurisdiction", "corpus_id", "source_task_sha256",
    "target", "evaluator_negative_cause", "legacy_refusal_code",
    "acceptable_answer_sets", "refusal_scope"
  ],
  "properties": {
    "gold_record_version": {"const": "v2.4"},
    "schema_id": {"const": "agent_gold_record.v2.4"},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"const": "narrative_citation"},
    "template_id": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "minLength": 1},
    "strata": {"type": "object"},
    "jurisdiction": {"const": "US"},
    "corpus_id": {"type": "string", "minLength": 1},
    "source_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_negative_cause": {"type": ["string", "null"]},
    "legacy_refusal_code": {"type": ["string", "null"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "answer_text", "chunk_evidence_ids", "refusal_code", "filing_id", "period_key"],
      "properties": {
        "status": {"enum": ["OK", "REFUSAL"]},
        "answer_text": {"type": ["string", "null"]},
        "chunk_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "refusal_code": {"type": ["string", "null"]},
        "filing_id": {"type": "string", "minLength": 1},
        "period_key": {"type": "string", "minLength": 1}
      }
    },
    "acceptable_answer_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set_id", "extracts"],
        "properties": {
          "set_id": {"type": "string", "minLength": 1},
          "extracts": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["evidence_id", "support_window", "required_semantic_anchors"],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1},
                "support_window": {"type": "string", "minLength": 1, "maxLength": 1000},
                "required_semantic_anchors": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "refusal_scope": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "scope_description", "causal_negative_type", "absent_claim",
            "full_filing_chunk_count", "full_filing_text_sha256", "mechanical_absence_check"
          ],
          "properties": {
            "scope_description": {"type": "string", "minLength": 1},
            "causal_negative_type": {"type": "string", "minLength": 1},
            "absent_claim": {"type": "string", "minLength": 1},
            "full_filing_chunk_count": {"type": "integer", "minimum": 1},
            "full_filing_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "mechanical_absence_check": {"const": true}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"target": {"properties": {"status": {"const": "OK"}}}}},
      "then": {
        "properties": {
          "acceptable_answer_sets": {"minItems": 1},
          "refusal_scope": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "acceptable_answer_sets": {"maxItems": 0},
          "refusal_scope": {"type": "object"}
        }
      }
    }
  ]
}
