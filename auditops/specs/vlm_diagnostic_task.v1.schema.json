{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vlm_diagnostic_task.v1",
  "title": "AuditOps VlmDiagnosticTaskV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostic_version", "task_id", "pair_id", "company_number",
    "filing_id", "pdf_path", "page_count", "requested_facts",
    "required_output", "bbox_gold_available"
  ],
  "properties": {
    "diagnostic_version": {"const": "companies-house-vlm-diagnostic.v1"},
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "pair_id": {"type": "string", "minLength": 1},
    "company_number": {"type": "string", "minLength": 1},
    "filing_id": {"type": "string", "minLength": 1},
    "pdf_path": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "requested_facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "page", "bbox", "evidence_text"],
      "properties": {
        "value": {"const": true},
        "page": {"const": true},
        "bbox": {"const": true},
        "evidence_text": {"const": true}
      }
    },
    "bbox_gold_available": {"const": false}
  }
}
