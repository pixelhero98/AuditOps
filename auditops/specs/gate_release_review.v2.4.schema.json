{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditops.local/specs/gate_release_review.v2.4.schema.json",
  "title": "GateReleaseReviewV2.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_release_review_version", "benchmark_id", "run_manifest_sha256",
    "reviewer", "benchmark_defect_status", "decisions"
  ],
  "properties": {
    "gate_release_review_version": {"const": "auditops-gate-release-review.v2.4"},
    "benchmark_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "reviewed_at"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "benchmark_defect_status": {"enum": ["NONE_FOUND", "DEFECT_FOUND"]},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "quote_answers_question", "comment"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "quote_answers_question": {"type": "boolean"},
          "comment": {"type": ["string", "null"]}
        }
      }
    }
  }
}
