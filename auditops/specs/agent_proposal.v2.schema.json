{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_proposal.v2",
  "title": "AuditOps AgentProposalV2",
  "oneOf": [
    {"$ref": "#/$defs/callTool"},
    {"$ref": "#/$defs/quantitativeAnswer"},
    {"$ref": "#/$defs/narrativeAnswer"},
    {"$ref": "#/$defs/refusal"}
  ],
  "$defs": {
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$"
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "evidence_ids", "supporting_text"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supporting_text": {"type": "string", "minLength": 1}
      }
    },
    "callTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_proposal_version", "task_id", "action", "tool_name",
        "tool_arguments", "status", "value", "unit", "period_key",
        "answer_text", "evidence_ids", "claims", "refusal_code",
        "model_uncertainty", "model_escalation_requested"
      ],
      "properties": {
        "agent_proposal_version": {"const": "v2"},
        "task_id": {"type": "string", "minLength": 1},
        "action": {"const": "CALL_TOOL"},
        "tool_name": {"enum": ["evaluate_metric_spec", "retrieve_evidence"]},
        "tool_arguments": {"$ref": "tool_arguments.v2.schema.json"},
        "status": {"type": "null"},
        "value": {"type": "null"},
        "unit": {"type": "null"},
        "period_key": {"type": "null"},
        "answer_text": {"type": "null"},
        "evidence_ids": {"type": "array", "maxItems": 0},
        "claims": {"type": "array", "maxItems": 0},
        "refusal_code": {"type": "null"},
        "model_uncertainty": {"const": "NONE"},
        "model_escalation_requested": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"tool_name": {"const": "evaluate_metric_spec"}}},
          "then": {"properties": {"tool_arguments": {"$ref": "tool_arguments.v2.schema.json#/$defs/metric"}}},
          "else": {"properties": {"tool_arguments": {"$ref": "tool_arguments.v2.schema.json#/$defs/retrieval"}}}
        }
      ]
    },
    "quantitativeAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_proposal_version", "task_id", "action", "tool_name",
        "tool_arguments", "status", "value", "unit", "period_key",
        "answer_text", "evidence_ids", "claims", "refusal_code",
        "model_uncertainty", "model_escalation_requested"
      ],
      "properties": {
        "agent_proposal_version": {"const": "v2"},
        "task_id": {"type": "string", "minLength": 1},
        "action": {"const": "ANSWER"},
        "tool_name": {"type": "null"},
        "tool_arguments": {"type": "null"},
        "status": {"const": "OK"},
        "value": {"$ref": "#/$defs/canonicalDecimal"},
        "unit": {"type": "string", "minLength": 1},
        "period_key": {"type": "string", "minLength": 1},
        "answer_text": {"type": "null"},
        "evidence_ids": {
          "allOf": [
            {"$ref": "#/$defs/evidenceIds"},
            {"minItems": 1}
          ]
        },
        "claims": {"type": "array", "maxItems": 0},
        "refusal_code": {"type": "null"},
        "model_uncertainty": {"enum": ["NONE", "LOW", "HIGH"]},
        "model_escalation_requested": {"type": "boolean"}
      }
    },
    "narrativeAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_proposal_version", "task_id", "action", "tool_name",
        "tool_arguments", "status", "value", "unit", "period_key",
        "answer_text", "evidence_ids", "claims", "refusal_code",
        "model_uncertainty", "model_escalation_requested"
      ],
      "properties": {
        "agent_proposal_version": {"const": "v2"},
        "task_id": {"type": "string", "minLength": 1},
        "action": {"const": "ANSWER"},
        "tool_name": {"type": "null"},
        "tool_arguments": {"type": "null"},
        "status": {"const": "OK"},
        "value": {"type": "null"},
        "unit": {"type": "null"},
        "period_key": {"type": "string", "minLength": 1},
        "answer_text": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "allOf": [
            {"$ref": "#/$defs/evidenceIds"},
            {"minItems": 1}
          ]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim"}
        },
        "refusal_code": {"type": "null"},
        "model_uncertainty": {"enum": ["NONE", "LOW", "HIGH"]},
        "model_escalation_requested": {"type": "boolean"}
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_proposal_version", "task_id", "action", "tool_name",
        "tool_arguments", "status", "value", "unit", "period_key",
        "answer_text", "evidence_ids", "claims", "refusal_code",
        "model_uncertainty", "model_escalation_requested"
      ],
      "properties": {
        "agent_proposal_version": {"const": "v2"},
        "task_id": {"type": "string", "minLength": 1},
        "action": {"const": "REFUSE"},
        "tool_name": {"type": "null"},
        "tool_arguments": {"type": "null"},
        "status": {"const": "REFUSAL"},
        "value": {"type": "null"},
        "unit": {"type": "null"},
        "period_key": {"type": "string", "minLength": 1},
        "answer_text": {"type": "null"},
        "evidence_ids": {"type": "array", "maxItems": 0},
        "claims": {"type": "array", "maxItems": 0},
        "refusal_code": {
          "enum": [
            "AMBIGUOUS_CONTEXT", "DIVISION_BY_ZERO", "INCOMPATIBLE_UNITS",
            "MISSING_INPUT", "NARRATIVE_CITATION_MISS",
            "NARRATIVE_NOT_SUPPORTED", "PERIOD_NOT_SUPPORTED",
            "PROMPT_INJECTION_DETECTED", "TASK_NOT_SUPPORTED",
            "UNSUPPORTED_REQUEST", "ZERO_DENOMINATOR"
          ]
        },
        "model_uncertainty": {"enum": ["NONE", "LOW", "HIGH"]},
        "model_escalation_requested": {"type": "boolean"}
      }
    }
  }
}
