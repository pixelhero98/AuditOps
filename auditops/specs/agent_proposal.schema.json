{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_proposal.v1",
  "title": "AuditOps AgentProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_proposal_version",
    "task_id",
    "action",
    "tool_name",
    "tool_arguments",
    "status",
    "value",
    "unit",
    "period_key",
    "answer_text",
    "evidence_ids",
    "claims",
    "refusal_code",
    "uncertainty",
    "escalation_required"
  ],
  "properties": {
    "agent_proposal_version": {"const": "v1"},
    "task_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["CALL_TOOL", "ANSWER", "REFUSE"]},
    "tool_name": {"type": ["string", "null"], "minLength": 1},
    "tool_arguments": {"type": ["object", "null"]},
    "status": {"enum": ["OK", "REFUSAL", null]},
    "value": {"type": ["string", "number", "null"]},
    "unit": {"type": ["string", "null"], "minLength": 1},
    "period_key": {"type": ["string", "null"], "minLength": 1},
    "answer_text": {"type": ["string", "null"], "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "evidence_ids", "supporting_text"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "supporting_text": {"type": "string", "minLength": 1}
        }
      }
    },
    "refusal_code": {"type": ["string", "null"], "minLength": 1},
    "uncertainty": {"enum": ["NONE", "LOW", "HIGH"]},
    "escalation_required": {"type": "boolean"}
  }
}
