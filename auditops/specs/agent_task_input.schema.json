{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_task_input.v1",
  "title": "AuditOps AgentTaskInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_task_input_version",
    "task_id",
    "task_type",
    "jurisdiction",
    "reporting_framework",
    "standards_profile",
    "source_system",
    "question",
    "entity",
    "filing",
    "period",
    "task_parameters",
    "allowed_tools",
    "evidence_scope",
    "output_schema_id",
    "refusal_policy"
  ],
  "properties": {
    "agent_task_input_version": {"const": "v1"},
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["quant_metric", "narrative_citation", "vlm_diagnostic"]},
    "jurisdiction": {"enum": ["US", "UK"]},
    "reporting_framework": {"type": "string", "minLength": 1},
    "standards_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source_system": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "name"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "ticker": {"type": ["string", "null"], "minLength": 1},
        "source_entity_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "filing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filing_id"],
      "properties": {
        "filing_id": {"type": "string", "minLength": 1},
        "form_type": {"type": ["string", "null"], "minLength": 1},
        "accession": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period_key"],
      "properties": {
        "period_key": {"type": "string", "minLength": 1},
        "start_date": {"type": ["string", "null"], "minLength": 1},
        "end_date": {"type": ["string", "null"], "minLength": 1},
        "instant": {"type": ["string", "null"], "minLength": 1},
        "selector_periods": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "dependentRequired": {
            "prior_year_period_end_asof": ["current_period_end_asof"]
          },
          "properties": {
            "current_period_end_asof": {
              "type": "string",
              "pattern": "^ASOF_[0-9]{8}$"
            },
            "prior_year_period_end_asof": {
              "type": "string",
              "pattern": "^ASOF_[0-9]{8}$"
            }
          }
        }
      }
    },
    "task_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_spec_id", "retrieval_query"],
      "properties": {
        "metric_spec_id": {"type": ["string", "null"], "minLength": 1},
        "retrieval_query": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["evaluate_metric_spec", "retrieve_evidence"]}
    },
    "evidence_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "max_items"],
      "properties": {
        "evidence_ids": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "filing_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "max_items": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "output_schema_id": {"type": "string", "minLength": 1},
    "refusal_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_codes"],
      "properties": {
        "allowed_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"task_type": {"const": "quant_metric"}}},
      "then": {
        "properties": {
          "task_parameters": {
            "properties": {
              "metric_spec_id": {"type": "string", "minLength": 1},
              "retrieval_query": {"type": "null"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "period": {
            "not": {"required": ["selector_periods"]}
          },
          "task_parameters": {
            "properties": {
              "metric_spec_id": {"type": "null"},
              "retrieval_query": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
