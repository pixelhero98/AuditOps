{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_run_record.v2",
  "title": "AuditOps AgentRunRecordV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_run_record_version", "run_id", "task_id", "corpus_id",
    "benchmark_manifest_sha256", "runtime_mode", "runtime_version", "prompt_condition",
    "prompt_version", "prompt_sha256", "canonical_json_version",
    "semantic_model_config_sha256", "deployment_model_config_sha256",
    "stage_schema_bundle_sha256", "run_envelope_sha256", "model_config",
    "context_sha256", "input_sha256", "output_sha256", "tool_calls",
    "verifier_trace", "verifier_result", "repair_count", "outcome",
    "token_usage", "timings", "resources", "provenance"
  ],
  "properties": {
    "agent_run_record_version": {"const": "v2"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{24}$"},
    "task_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "benchmark_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_mode": {"enum": ["direct", "agent"]},
    "runtime_version": {"const": "auditops.agent_runtime.v2"},
    "prompt_condition": {"enum": ["zero_shot", "few_shot"]},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_json_version": {"const": "auditops.canonical_json.v1"},
    "semantic_model_config_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_model_config_sha256": {"$ref": "#/$defs/sha256"},
    "stage_schema_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "run_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "model_config": {"$ref": "model_config.v2.schema.json"},
    "context_sha256": {"$ref": "#/$defs/nullableSha256"},
    "input_sha256": {"$ref": "#/$defs/nullableSha256"},
    "output_sha256": {"$ref": "#/$defs/nullableSha256"},
    "tool_calls": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/toolCall"}
    },
    "verifier_trace": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/traceEntry"}
    },
    "verifier_result": {
      "oneOf": [
        {"$ref": "verifier_result.v2.schema.json"},
        {"type": "null"}
      ]
    },
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "outcome": {
      "enum": [
        "RELEASED", "SAFE_REFUSAL", "MODEL_FAILURE",
        "INFRASTRUCTURE_FAILURE", "INTEGRITY_FAILURE"
      ]
    },
    "token_usage": {"$ref": "#/$defs/tokenUsage"},
    "timings": {"$ref": "#/$defs/timings"},
    "resources": {"$ref": "#/$defs/resources"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "RELEASED"}}},
      "then": {
        "properties": {
          "verifier_result": {
            "allOf": [
              {"$ref": "verifier_result.v2.schema.json"},
              {
                "properties": {
                  "release_allowed": {"const": true},
                  "disposition": {"const": "RELEASED"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "SAFE_REFUSAL"}}},
      "then": {
        "properties": {
          "verifier_result": {
            "allOf": [
              {"$ref": "verifier_result.v2.schema.json"},
              {
                "properties": {
                  "release_allowed": {"const": true},
                  "disposition": {"const": "SAFE_REFUSAL"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {"const": "MODEL_FAILURE"}
        }
      },
      "then": {
        "properties": {
          "verifier_result": {
            "oneOf": [
              {"type": "null"},
              {
                "allOf": [
                  {"$ref": "verifier_result.v2.schema.json"},
                  {"properties": {"disposition": {"const": "FAILED"}}}
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {"enum": ["INFRASTRUCTURE_FAILURE", "INTEGRITY_FAILURE"]}
        }
      },
      "then": {
        "properties": {
          "verifier_result": {
            "oneOf": [
              {"type": "null"},
              {
                "allOf": [
                  {"$ref": "verifier_result.v2.schema.json"},
                  {
                    "properties": {
                      "disposition": {"enum": ["FAILED", "TOOL_CALL_APPROVED"]}
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"verifier_trace": {"maxItems": 0}}},
      "then": {"properties": {"verifier_result": {"type": "null"}}},
      "else": {
        "properties": {
          "verifier_result": {"$ref": "verifier_result.v2.schema.json"}
        }
      }
    },
    {
      "if": {
        "properties": {"verifier_trace": {"minItems": 1, "maxItems": 1}}
      },
      "then": {
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "RELEASED"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{"$ref": "#/$defs/releasedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "SAFE_REFUSAL"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{"$ref": "#/$defs/safeRefusalTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "MODEL_FAILURE"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{"$ref": "#/$defs/failedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["INFRASTRUCTURE_FAILURE", "INTEGRITY_FAILURE"]
                }
              }
            },
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{"$ref": "#/$defs/operationalTerminalEntry"}]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"verifier_trace": {"minItems": 2, "maxItems": 2}}
      },
      "then": {
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "RELEASED"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {"$ref": "#/$defs/releasedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "SAFE_REFUSAL"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {"$ref": "#/$defs/safeRefusalTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "MODEL_FAILURE"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {"$ref": "#/$defs/failedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["INFRASTRUCTURE_FAILURE", "INTEGRITY_FAILURE"]
                }
              }
            },
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {"$ref": "#/$defs/operationalTerminalEntry"}]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"verifier_trace": {"minItems": 3, "maxItems": 3}}
      },
      "then": {
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "RELEASED"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {"$ref": "#/$defs/releasedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "SAFE_REFUSAL"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {"$ref": "#/$defs/safeRefusalTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "MODEL_FAILURE"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {"$ref": "#/$defs/failedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["INFRASTRUCTURE_FAILURE", "INTEGRITY_FAILURE"]
                }
              }
            },
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {"$ref": "#/$defs/operationalTerminalEntry"}]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"verifier_trace": {"minItems": 4, "maxItems": 4}}
      },
      "then": {
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "RELEASED"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/releasedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "SAFE_REFUSAL"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/safeRefusalTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "MODEL_FAILURE"}}},
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/failedTerminalEntry"}]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["INFRASTRUCTURE_FAILURE", "INTEGRITY_FAILURE"]
                }
              }
            },
            "then": {
              "properties": {
                "verifier_trace": {
                  "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/operationalTerminalEntry"}]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name", "arguments_sha256", "observation_sha256", "status",
        "duration_ms"
      ],
      "properties": {
        "tool_name": {"enum": ["evaluate_metric_spec", "retrieve_evidence"]},
        "arguments_sha256": {"$ref": "#/$defs/sha256"},
        "observation_sha256": {"$ref": "#/$defs/nullableSha256"},
        "status": {"enum": ["OK", "ERROR"]},
        "duration_ms": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "OK"}}},
          "then": {
            "properties": {
              "observation_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "traceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "attempt_index", "repair_attempt", "prompt_sha256",
        "request_sha256", "response_schema_sha256", "output_sha256",
        "proposal", "proposal_sha256", "verifier_result", "input_tokens",
        "output_tokens", "duration_ms"
      ],
      "properties": {
        "stage": {"enum": ["plan", "synthesis", "direct"]},
        "attempt_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "repair_attempt": {"type": "boolean"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/nullableSha256"},
        "proposal": {
          "oneOf": [
            {"$ref": "agent_proposal.v2.schema.json"},
            {"type": "null"}
          ]
        },
        "proposal_sha256": {"$ref": "#/$defs/nullableSha256"},
        "verifier_result": {"$ref": "verifier_result.v2.schema.json"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"proposal": {"type": "null"}}},
          "then": {"properties": {"proposal_sha256": {"type": "null"}}},
          "else": {
            "properties": {"proposal_sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      ]
    },
    "releasedTerminalEntry": {
      "allOf": [
        {"$ref": "#/$defs/traceEntry"},
        {
          "properties": {
            "verifier_result": {
              "allOf": [
                {"$ref": "verifier_result.v2.schema.json"},
                {"properties": {"disposition": {"const": "RELEASED"}}}
              ]
            }
          }
        }
      ]
    },
    "safeRefusalTerminalEntry": {
      "allOf": [
        {"$ref": "#/$defs/traceEntry"},
        {
          "properties": {
            "verifier_result": {
              "allOf": [
                {"$ref": "verifier_result.v2.schema.json"},
                {"properties": {"disposition": {"const": "SAFE_REFUSAL"}}}
              ]
            }
          }
        }
      ]
    },
    "failedTerminalEntry": {
      "allOf": [
        {"$ref": "#/$defs/traceEntry"},
        {
          "properties": {
            "verifier_result": {
              "allOf": [
                {"$ref": "verifier_result.v2.schema.json"},
                {"properties": {"disposition": {"const": "FAILED"}}}
              ]
            }
          }
        }
      ]
    },
    "operationalTerminalEntry": {
      "allOf": [
        {"$ref": "#/$defs/traceEntry"},
        {
          "properties": {
            "verifier_result": {
              "allOf": [
                {"$ref": "verifier_result.v2.schema.json"},
                {
                  "properties": {
                    "disposition": {"enum": ["FAILED", "TOOL_CALL_APPROVED"]}
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "duration_ms"],
      "properties": {
        "started_at": {"type": "string", "minLength": 1},
        "finished_at": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "number", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slurm_job_id", "gpu_model", "peak_vram_bytes", "host"],
      "properties": {
        "slurm_job_id": {"type": ["string", "null"], "minLength": 1},
        "gpu_model": {"type": ["string", "null"], "minLength": 1},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "host": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit", "source_tree_sha256", "container_digest",
        "model_snapshot_sha256", "tokenizer_revision", "package_lock_sha256"
      ],
      "properties": {
        "git_commit": {"type": ["string", "null"], "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/nullableSha256"},
        "container_digest": {"type": ["string", "null"], "minLength": 1},
        "model_snapshot_sha256": {"$ref": "#/$defs/nullableSha256"},
        "tokenizer_revision": {"type": ["string", "null"], "minLength": 1},
        "package_lock_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    }
  }
}
